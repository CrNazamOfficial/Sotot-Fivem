                sendChatMessage("/antilag")
                task.wait(2)
                sendChatMessage("/crosshair 2")
                task.wait(2)
                sendChatMessage("/hit 4")
                task.wait(2)
                sendChatMessage("/color 0")
                task.wait(2)
                sendChatMessage("/edithud")
            end)
        end)
        
        blockRollBtn.MouseButton1Click:Connect(function()
            _G.BlockRollEnabled = not _G.BlockRollEnabled
            
            if _G.BlockRollEnabled then
                blockRollBtn.Text = "BLOCK ROLL: ON"
                TweenService:Create(blockRollBtn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(75, 0, 130),
