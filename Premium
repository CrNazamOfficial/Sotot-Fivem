local Cam = workspace.CurrentCamera
local espConns = {}
local espData  = {}

local function nd(t,p)
    local o=Drawing.new(t)
    for k,v in pairs(p) do o[k]=v end
    return o
end

local function clearESP()
    for _,d in pairs(espData) do for _,o in pairs(d) do pcall(function() o:Remove() end) end end
    espData={}
    for _,c in pairs(espConns) do pcall(function() c:Disconnect() end) end
    espConns={}
end

local function createESP(tgt)
    if tgt==player then return end
    local D={
        bT=nd("Line",{Thickness=2,Color=Color3.fromRGB(0,1,3),Visible=false,ZIndex=5}),
        bB=nd("Line",{Thickness=2,Color=Color3.fromRGB(0,1,3),Visible=false,ZIndex=5}),
        bL=nd("Line",{Thickness=2,Color=Color3.fromRGB(0,1,3),Visible=false,ZIndex=5}),
        bR=nd("Line",{Thickness=2,Color=Color3.fromRGB(0,1,3),Visible=false,ZIndex=5}),
        hBg=nd("Line",{Thickness=11,Color=Color3.fromRGB(0,1,3),Visible=false,ZIndex=4}),
        hBar=nd("Line",{Thickness=11,Color=Color3.fromRGB(0,255,0),Visible=false,ZIndex=5}),
        tr=nd("Line",{Thickness=1.5,Color=Color3.fromRGB(0,1,3),Visible=false,ZIndex=3}),
    }
    espData[tgt.UserId]=D
    local conn=RunService.RenderStepped:Connect(function()
        if not _G.ESPEnabled then for _,d in pairs(D) do d.Visible=false end return end
        local char=tgt.Character
        if not char then for _,d in pairs(D) do d.Visible=false end return end
        local hrp=char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChildOfClass("Humanoid")
        local head=char:FindFirstChild("Head")
        if not hrp or not hum or not head or hum.Health<=0 then for _,d in pairs(D) do d.Visible=false end return end
        local rp,on=Cam:WorldToViewportPoint(hrp.Position)
        if not on then for _,d in pairs(D) do d.Visible=false end return end
        local hp=Cam:WorldToViewportPoint(head.Position)
        local fp=Cam:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
        local h=math.abs(hp.Y-fp.Y) local w=h*0.65 local cx=rp.X
        local l,r,t,b=cx-w/2,cx+w/2,hp.Y-5,fp.Y+3
        D.bT.From=Vector2.new(l,t) D.bT.To=Vector2.new(r,t)
        D.bB.From=Vector2.new(l,b) D.bB.To=Vector2.new(r,b)
        D.bL.From=Vector2.new(l,t) D.bL.To=Vector2.new(l,b)
        D.bR.From=Vector2.new(r,t) D.bR.To=Vector2.new(r,b)
        D.bT.Visible=true D.bB.Visible=true D.bL.Visible=true D.bR.Visible=true
        local hx=l-8 local pct=math.clamp(hum.Health/hum.MaxHealth,0,1) local fill=(b-t)*pct
        D.hBg.From=Vector2.new(hx,t) D.hBg.To=Vector2.new(hx,b) D.hBg.Visible=true
        D.hBar.From=Vector2.new(hx,b) D.hBar.To=Vector2.new(hx,b-fill) D.hBar.Visible=true
        D.hBar.Color=pct>0.6 and Color3.fromRGB(0,255,0) or pct>0.3 and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0)
        local ss=Cam.ViewportSize
        D.tr.From=Vector2.new(ss.X/2,ss.Y) D.tr.To=Vector2.new(cx,b) D.tr.Visible=true
    end)
    table.insert(espConns,conn)
    tgt.CharacterRemoving:Connect(function() for _,d in pairs(D) do d.Visible=false end end)
end

local function updateESP()
    if _G.ESPEnabled then
        for _,v in pairs(Players:GetPlayers()) do if not espData[v.UserId] then createESP(v) end end
        Players.PlayerAdded:Connect(function(v) if _G.ESPEnabled then createESP(v) end end)
    else clearESP() end
end

