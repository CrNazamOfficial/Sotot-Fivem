                BackgroundColor3 = Color3.fromRGB(45, 45, 55),
                TextColor3 = Color3.fromRGB(220, 220, 230)
            }):Play()
        end
        
        updateInfiniteAmmo()
    end)
    
    espBtn.MouseButton1Click:Connect(function()
        _G.ESPEnabled = not _G.ESPEnabled
        
