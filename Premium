-- ============================================================
-- AUTO SCOPE
-- ============================================================
local function activateScope()
    if not _G.AutoScopeEnabled or isScopeActive then return end
    local character = player.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    for _, d in pairs(tool:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local n = d.Name:lower()
            if n:match("scope") or n:match("aim") or n:match("zoom") or n:match("ads") then
                pcall(function() d:FireServer(true) d:FireServer("Aim",true) d:FireServer({Scope=true}) end)
            end
        elseif d:IsA("BindableEvent") then
            local n = d.Name:lower()
            if n:match("scope") or n:match("aim") or n:match("zoom") then
                pcall(function() d:Fire(true) end)
            end
        end
    end
    pcall(function()
        local VU = game:GetService("VirtualUser")
        VU:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    isScopeActive = true
end

local function deactivateScope()
    if not isScopeActive then return end
    local character = player.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            for _, d in pairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") then
                    local n = d.Name:lower()
                    if n:match("scope") or n:match("aim") or n:match("zoom") or n:match("ads") then
                        pcall(function() d:FireServer(false) d:FireServer("Aim",false) d:FireServer({Scope=false}) end)
                    end
                end
            end
        end
    end
    pcall(function()
        local VU = game:GetService("VirtualUser")
        VU:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    isScopeActive = false
end

local function monitorScope()
    if not _G.AutoScopeEnabled then return end
    local has = player.Character and player.Character:FindFirstChildOfClass("Tool") ~= nil
    if has and not isHoldingWeapon then
        isHoldingWeapon = true
        task.wait(scopeDelay)
        activateScope()
    elseif not has and isHoldingWeapon then
        isHoldingWeapon = false
        deactivateScope()
    end
end
task.spawn(function() while task.wait(0.15) do pcall(monitorScope) end end)

