local function realisticKill(tgt)
    if not isVIP then return false end
    local w=player.Character and player.Character:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
    if not w then return false end
    local tHead=tgt.Character and tgt.Character:FindFirstChild("Head")
    if not tHead then return false end
    local char=player.Character if not char then return false end
    local orig=char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not orig then return false end
    local dist=(tHead.Position-orig.Position).Magnitude
    WeaponFired:FireServer(w,{["id"]=41,["charge"]=0,["dir"]=(tHead.Position-orig.Position).Unit,["origin"]=orig.Position})
    task.wait(math.clamp(dist/1000,0.01,0.1))
    for i=1,8 do
        WeaponHit:FireServer(w,{["p"]=tHead.Position,["pid"]=tgt.UserId,["part"]=tHead,["d"]=500,["maxDist"]=dist,["h"]=tHead,["m"]=tHead.Material,["sid"]=41,["t"]=tick()+(i*0.001),["n"]=Vector3.new(0,1,0)})
        task.wait(0.01)
    end
    return true
end

local function killTarget(name)
    if not isVIP or _G.KillingInProgress then return end
    local tgt
    local sn=name:lower()
    for _,p in pairs(Players:GetPlayers()) do
        if p.Name:lower()==sn or p.DisplayName:lower()==sn then tgt=p break end
    end
    if not tgt then
        for _,p in pairs(Players:GetPlayers()) do
            if p.Name:lower():find(sn) or p.DisplayName:lower():find(sn) then tgt=p break end
        end
    end
    if not tgt or tgt==player or not tgt.Character then return end
    _G.KillingInProgress=true
    realisticKill(tgt)
    task.wait(8.83)
    _G.KillingInProgress=false
end

local killAllBtnRef=nil
local function killAll()
    if not isVIP then return end
    local btn=killAllBtnRef
    if _G.KillingInProgress then
        _G.KillingInProgress=false
        if btn then btn.Text="KILL ALL" TweenService:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(38,38,52)}):Play() end
        return
    end
    _G.KillingInProgress=true
    if btn then btn.Text="STOP" TweenService:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(192,38,51)}):Play() end
    task.spawn(function()
        while _G.KillingInProgress do
            for _,tgt in pairs(Players:GetPlayers()) do
                if tgt~=player and tgt.Character then
                    local hum=tgt.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health>0 then
                        task.spawn(function() if _G.KillingInProgress then realisticKill(tgt) end end)
                    end
                end
            end
            task.wait(0.3)
            if _G.KillingInProgress then
                if not pcall(function() player:LoadCharacter() end) then
                    pcall(function() local h=player.Character and player.Character:FindFirstChild("Humanoid") if h then h.Health=0 end end)
                end
            end
            if _G.KillingInProgress then task.wait(8.83) end
        end
        if btn then btn.Text="KILL ALL" TweenService:Create(btn,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(38,38,52)}):Play() end
    end)
end

