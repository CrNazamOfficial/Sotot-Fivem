local recoilConn, cameraConn
if isVIP then
    local cam = workspace.CurrentCamera
    local lastCF = cam.CFrame
    _G.UpdateNoRecoil = function()
        if recoilConn then recoilConn:Disconnect() end
        if cameraConn then cameraConn:Disconnect() end
        if not _G.NoRecoilEnabled then return end
        recoilConn = RunService.RenderStepped:Connect(function()
            if not _G.NoRecoilEnabled then return end
            pcall(function()
                local char = player.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        for _,obj in pairs(tool:GetDescendants()) do
                            if (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
                                local n = obj.Name:lower()
                                if n:find("recoil") or n:find("spread") or n:find("kick") or n:find("sway") then obj.Value=0 end
                            end
                        end
                    end
                    local hum = char:FindFirstChild("Humanoid")
                    if hum then hum.CameraOffset=Vector3.new(0,0,0) end
                end
            end)
        end)
        cameraConn = RunService.RenderStepped:Connect(function()
            if not _G.NoRecoilEnabled then return end
            pcall(function()
                local cur = cam.CFrame
                if (cur-lastCF).Rotation.Magnitude>0.1 then cam.CFrame=lastCF:Lerp(cur,0.3) end
                lastCF = cam.CFrame
            end)
        end)
    end
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if _G.NoRecoilEnabled then _G.UpdateNoRecoil() end
    end)
end

