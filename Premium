local function loadVIPList()
    if isfile("vip_list.json") then
        pcall(function()
            _G.VIPSystem.VIPList = HttpService:JSONDecode(readfile("vip_list.json"))
        end)
    end
end

local function checkVIP()
    loadVIPList()
    local username = LocalPlayer.Name
    local currentTime = os.time()
    if _G.VIPSystem.VIPList[username] then
        local expireTime = _G.VIPSystem.VIPList[username].expire
        if expireTime > currentTime then
            _G.VIPSystem.UserIsVIP = true
            return true
        else
            _G.VIPSystem.VIPList[username] = nil
            writefile("vip_list.json", HttpService:JSONEncode(_G.VIPSystem.VIPList))
        end
    end
    _G.VIPSystem.UserIsVIP = false
    return false
end

_G.UnlimitedAmmoEnabled = false
local function setupUnlimitedAmmo()
    spawn(function()
        while wait(0.1) do
            if _G.UnlimitedAmmoEnabled then
                pcall(function()
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool and tool:FindFirstChild("Ammo") then tool.Ammo.Value = 999 end
                    if LocalPlayer.Backpack then
                        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if item:IsA("Tool") and item:FindFirstChild("Ammo") then item.Ammo.Value = 999 end
                        end
                    end
                end)
            end
        end
    end)
end

_G.ESPEnabled = false
local espBoxes = {}
local function createESPBox(player)
    if player == LocalPlayer then return end
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 0, 0)
    box.Thickness = 2
    box.Transparency = 1
    box.Filled = false
    espBoxes[player] = box
    
    RunService.RenderStepped:Connect(function()
        pcall(function()
            if not _G.ESPEnabled or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                box.Visible = false
                return
            end
            local hrp = player.Character.HumanoidRootPart
            local camera = workspace.CurrentCamera
            local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local scaleFactor = 1 / (vector.Z * math.tan(math.rad(camera.FieldOfView / 2)) * 2) * 1000
                local width, height = math.floor(50 * scaleFactor), math.floor(70 * scaleFactor)
                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
                box.Visible = true
            else
                box.Visible = false
            end
        end)
    end)
end

local function setupESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then createESPBox(player) end
    end
    Players.PlayerAdded:Connect(function(player) wait(1) createESPBox(player) end)
    Players.PlayerRemoving:Connect(function(player)
        if espBoxes[player] then espBoxes[player]:Remove() espBoxes[player] = nil end
    end)
end

_G.HitBoxEnabled = false
_G.HitBoxSize = 20
local function setupHitBox()
    RunService.RenderStepped:Connect(function()
        if _G.HitBoxEnabled and _G.VIPSystem.UserIsVIP then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    pcall(function()
                        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local hrp = player.Character.HumanoidRootPart
                            hrp.Size = Vector3.new(_G.HitBoxSize, _G.HitBoxSize, _G.HitBoxSize)
                            hrp.Transparency = 0.8
                            hrp.CanCollide = false
                        end
                    end)
                end
            end
        end
    end)
end

local function killPlayer(targetPlayer)
    if not _G.VIPSystem.UserIsVIP then return end
    pcall(function()
        local args = {[1] = targetPlayer.Character.Humanoid, [2] = 100}
        for _, remote in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if remote:IsA("RemoteEvent") and (remote.Name:lower():find("damage") or remote.Name:lower():find("hit") or remote.Name:lower():find("health")) then
                remote:FireServer(unpack(args))
            end
        end
    end)
end

local function killAllPlayers()
    if not _G.VIPSystem.UserIsVIP then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then killPlayer(player) wait(0.1) end
    end
end

