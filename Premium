                }):Play()
            else
                blockRollBtn.Text = "BLOCK ROLL: OFF"
                TweenService:Create(blockRollBtn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(45, 45, 55),
                    TextColor3 = Color3.fromRGB(220, 220, 230)
                }):Play()
            end
            
            if _G.UpdateBlockRoll then _G.UpdateBlockRoll() end
        end)
        
        killPlayerBtn.MouseButton1Click:Connect(function()
            if usernameInput.Text ~= "" then
                killTargetPlayer(usernameInput.Text)
            end
        end)
        
        killAllBtn.MouseButton1Click:Connect(function()
            killAllPlayers(killAllBtn)
        end)
        
        hitBoxBtn.MouseButton1Click:Connect(function()
            _G.HitBoxEnabled = not _G.HitBoxEnabled
            
            if _G.HitBoxEnabled then
                hitBoxBtn.Text = "HITBOX: ON"
                TweenService:Create(hitBoxBtn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(75, 0, 130),
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                }):Play()
            else
                hitBoxBtn.Text = "HITBOX: OFF"
                TweenService:Create(hitBoxBtn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(45, 45, 55),
                    TextColor3 = Color3.fromRGB(220, 220, 230)
                }):Play()
            end
        end)
    end
    
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        currentTool = nil
        weaponLabel.Text = "Weapon: None"
    end)
