local function activateScope()
    if not _G.AutoScopeEnabled then return end
    if isScopeActive then return end
    
    local character = player.Character
    if not character then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Method 1: Cari dan fire RemoteEvent untuk scope
    for _, descendant in pairs(tool:GetDescendants()) do
        if descendant:IsA("RemoteEvent") then
            local name = string.lower(descendant.Name)
            if string.match(name, "scope") or string.match(name, "aim") or string.match(name, "zoom") or string.match(name, "ads") then
                pcall(function()
                    descendant:FireServer(true)
                    descendant:FireServer("Aim", true)
                    descendant:FireServer({Scope = true})
                end)
            end
        end
    end
    
    -- Method 2: Cari BindableEvent lokal
    for _, descendant in pairs(tool:GetDescendants()) do
        if descendant:IsA("BindableEvent") then
            local name = string.lower(descendant.Name)
            if string.match(name, "scope") or string.match(name, "aim") or string.match(name, "zoom") then
                pcall(function()
                    descendant:Fire(true)
                end)
            end
        end
    end
    
    -- Method 3: Simulate mouse button
    pcall(function()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    
    isScopeActive = true
end

local function deactivateScope()
    if not isScopeActive then return end
    
    local character = player.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        
        if tool then
            for _, descendant in pairs(tool:GetDescendants()) do
                if descendant:IsA("RemoteEvent") then
                    local name = string.lower(descendant.Name)
                    if string.match(name, "scope") or string.match(name, "aim") or string.match(name, "zoom") or string.match(name, "ads") then
                        pcall(function()
                            descendant:FireServer(false)
                            descendant:FireServer("Aim", false)
                            descendant:FireServer({Scope = false})
                        end)
                    end
                end
            end
        end
    end
    
    -- Release mouse button
    pcall(function()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    
    isScopeActive = false
end

local function isWeaponEquipped()
    local character = player.Character
    if not character then return false end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        return true
    end
    
    return false
end

local function monitorWeaponForScope()
    if not _G.AutoScopeEnabled then return end
    
    local currentlyHoldingWeapon = isWeaponEquipped()
    
    -- Baru pegang senjata
    if currentlyHoldingWeapon and not isHoldingWeapon then
        isHoldingWeapon = true
        task.wait(scopeDelay)
        activateScope()
    end
    
    -- Baru lepas senjata
    if not currentlyHoldingWeapon and isHoldingWeapon then
        isHoldingWeapon = false
        deactivateScope()
    end
end

