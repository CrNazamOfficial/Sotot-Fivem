local function realisticKill(target)
    if not isVIP then return false end
    
    local ourWeapon = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if not ourWeapon then ourWeapon = player.Backpack:FindFirstChildOfClass("Tool") end
    if not ourWeapon then return false end
    
    local targetHead = target.Character and target.Character:FindFirstChild("Head")
    if not targetHead then return false end
    
    local char = player.Character
    if not char then return false end
    
    local origin = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not origin then return false end
    
    local distance = (targetHead.Position - origin.Position).Magnitude
    
    WeaponFired:FireServer(ourWeapon, {
        ["id"] = 41,
        ["charge"] = 0,
        ["dir"] = (targetHead.Position - origin.Position).Unit,
        ["origin"] = origin.Position
    })
    
    local travelTime = math.clamp(distance / 1000, 0.01, 0.1)
    task.wait(travelTime)
    
    for i = 1, 8 do
        WeaponHit:FireServer(ourWeapon, {
            ["p"] = targetHead.Position,
            ["pid"] = target.UserId,
            ["part"] = targetHead,
            ["d"] = 500,
            ["maxDist"] = distance,
            ["h"] = targetHead,
            ["m"] = targetHead.Material,
            ["sid"] = 41,
            ["t"] = tick() + (i * 0.001),
            ["n"] = Vector3.new(0, 1, 0)
        })
        task.wait(0.01)
    end
    
    return true
end

local function killTargetPlayer(targetName)
    if not isVIP or _G.KillingInProgress then return end
    
    local target = nil
    local searchName = targetName:lower()
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower() == searchName or plr.DisplayName:lower() == searchName then
            target = plr
            break
        end
    end
    
    if not target then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Name:lower():find(searchName) or plr.DisplayName:lower():find(searchName) then
                target = plr
                break
            end
        end
    end
    
    if not target or target == player or not target.Character then return end
    
    _G.KillingInProgress = true
    realisticKill(target)
    task.wait(8.83)
    _G.KillingInProgress = false
end

local function killAllPlayers(killAllBtn)
    if not isVIP then return end
    
    if _G.KillingInProgress then
        _G.KillingInProgress = false
        killAllBtn.Text = "KILL ALL"
        TweenService:Create(killAllBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(153, 50, 204)
        }):Play()
        return
    end
    
    _G.KillingInProgress = true
    killAllBtn.Text = "STOP"
    TweenService:Create(killAllBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    }):Play()
    
    task.spawn(function()
        while _G.KillingInProgress do
            for _, target in pairs(Players:GetPlayers()) do
                if target ~= player and target.Character then
                    local hum = target.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        task.spawn(function()
                            if _G.KillingInProgress then
                                realisticKill(target)
                            end
                        end)
                    end
                end
            end
            
            task.wait(0.3)
            
            if _G.KillingInProgress then
                local respawnSuccess = pcall(function()
                    player:LoadCharacter()
                end)
                if not respawnSuccess then
                    pcall(function()
                        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
                        if hum then hum.Health = 0 end
                    end)
                end
            end
            
            if _G.KillingInProgress then
                task.wait(8.83)
            end
        end
        
        killAllBtn.Text = "KILL ALL"
        TweenService:Create(killAllBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(153, 50, 204)
        }):Play()
    end)
end

