            clearESP()

            -- Matikan scope jika aktif
            if isScopeActive then deactivateScope() end

            -- Putuskan recoil/camera
            if recoilConn then recoilConn:Disconnect() recoilConn=nil end
            if cameraConn then cameraConn:Disconnect() cameraConn=nil end

            -- Stop musik
            sound:Stop()
            sound:Destroy()

            -- Animasi keluar lalu destroy semua GUI
            TweenService:Create(mf,TweenInfo.new(0.22,Enum.EasingStyle.Back,Enum.EasingDirection.In),{
                Size=UDim2.new(0,0,0,0),
                Position=UDim2.new(0.5,0,0.5,0)
            }):Play()
            task.wait(0.25)

            -- Destroy seluruh GUI termasuk icon
            gui:Destroy()
        end)
    end

    closeBtn.MouseButton1Click:Connect(function() overlay.Visible=true end)
    dConf.MouseButton1Click:Connect(function()
        overlay.Visible=false
        doClose()
    end)
    dCanc.MouseButton1Click:Connect(function() overlay.Visible=false end)
    minBtn.MouseButton1Click:Connect(function() doMinimize() end)

    iconBtn.MouseButton1Click:Connect(function()
        -- Lanjutkan musik dari posisi terakhir
        sound:Resume()
        mf.Visible=true
        mf.Size=UDim2.new(0,0,0,0) mf.Position=UDim2.new(0.5,0,0.5,0)
        TweenService:Create(mf,TweenInfo.new(0.26,Enum.EasingStyle.Back),{
            Size=UDim2.new(0,FW,0,FH),
            Position=UDim2.new(0.5,-FW/2,0.5,-FH/2)
        }):Play()
        iconBtn.Visible=false
    end)

    -- ============================================================
    -- DRAG — main frame (delay sedang)
    -- ============================================================
    local drag,dStart,dStartPos=false,nil,nil
    hdr.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            drag=true dStart=inp.Position dStartPos=mf.Position
            inp.Changed:Connect(function() if inp.UserInputState==Enum.UserInputState.End then drag=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if drag and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then
            local d=inp.Position-dStart
            TweenService:Create(mf,TweenInfo.new(0.07,Enum.EasingStyle.Linear),{
                Position=UDim2.new(dStartPos.X.Scale,dStartPos.X.Offset+d.X,dStartPos.Y.Scale,dStartPos.Y.Offset+d.Y)
            }):Play()
        end
    end)

    -- ============================================================
    -- DRAG — icon (delay sedang)
    -- ============================================================
    local iDrag,iDStart,iDStartPos,iMoved=false,nil,nil,false
    iconBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            iDrag=true iDStart=inp.Position iDStartPos=iconBtn.Position iMoved=false
            inp.Changed:Connect(function() if inp.UserInputState==Enum.UserInputState.End then iDrag=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if iDrag and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then
            local d=inp.Position-iDStart
            if math.abs(d.X)>4 or math.abs(d.Y)>4 then iMoved=true end
            TweenService:Create(iconBtn,TweenInfo.new(0.07,Enum.EasingStyle.Linear),{
                Position=UDim2.new(iDStartPos.X.Scale,iDStartPos.X.Offset+d.X,iDStartPos.Y.Scale,iDStartPos.Y.Offset+d.Y)
            }):Play()
        end
    end)

    -- ============================================================
    -- CHARACTER RESET
    -- ============================================================
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        currentTool=nil isHoldingWeapon=false isScopeActive=false
    end)
end

createMainGUI()
