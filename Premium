local recoilConnection, cameraConnection

if isVIP then
    local camera = workspace.CurrentCamera
    local lastCameraCFrame = camera.CFrame
    
    local function enableNoRecoil()
        if recoilConnection then recoilConnection:Disconnect() end
        if cameraConnection then cameraConnection:Disconnect() end
        
        if not _G.NoRecoilEnabled then return end
        
        recoilConnection = RunService.RenderStepped:Connect(function()
            if not _G.NoRecoilEnabled then return end
            
            pcall(function()
                local character = player.Character
                if character then
                    local tool = character:FindFirstChildOfClass("Tool")
                    if tool then
                        for _, obj in pairs(tool:GetDescendants()) do
                            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                                local name = obj.Name:lower()
                                if name:find("recoil") or 
                                   name:find("spread") or 
                                   name:find("kick") or
                                   name:find("sway") then
                                    obj.Value = 0
                                end
                            end
                        end
                        
                        local humanoid = character:FindFirstChild("Humanoid")
                        if humanoid then
                            humanoid.CameraOffset = Vector3.new(0, 0, 0)
                        end
                    end
                end
            end)
        end)
        
        cameraConnection = RunService.RenderStepped:Connect(function()
            if not _G.NoRecoilEnabled then return end
            
            pcall(function()
                local currentCFrame = camera.CFrame
                local deltaRotation = (currentCFrame - lastCameraCFrame).Rotation
                
                if deltaRotation.Magnitude > 0.1 then
                    camera.CFrame = lastCameraCFrame:Lerp(currentCFrame, 0.3)
                end
                
                lastCameraCFrame = camera.CFrame
            end)
        end)
        
        local UserInputService = game:GetService("UserInputService")
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if not _G.NoRecoilEnabled then return end
            
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                task.wait(0.05)
                pcall(function()
                    local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid.CameraOffset = Vector3.new(0, 0, 0)
                    end
                end)
            end
        end)
    end
    
    _G.UpdateNoRecoil = enableNoRecoil
    
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if _G.NoRecoilEnabled then
            enableNoRecoil()
        end
    end)
end

local Camera = workspace.CurrentCamera
local espConnections = {}
local espData = {}

local BOX_COLOR = Color3.fromRGB(0, 1, 3)
local TRACER_COLOR = Color3.fromRGB(0, 1, 3)
local HP_BG_COLOR = Color3.fromRGB(0, 1, 3)
local HP_COLOR_HIGH = Color3.fromRGB(0, 255, 0)
local HP_COLOR_MID = Color3.fromRGB(255, 255, 0)
local HP_COLOR_LOW = Color3.fromRGB(255, 0, 0)

local function newDrawing(type, props)
    local obj = Drawing.new(type)
    for k, v in pairs(props) do
        obj[k] = v
    end
    return obj
end

local function clearESP()
    for _, data in pairs(espData) do
        for _, obj in pairs(data) do
            pcall(function() obj:Remove() end)
        end
    end
    espData = {}
    for _, conn in pairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
end

local function createESP(target)
    if target == player then return end

    local drawings = {
        boxTop    = newDrawing("Line", {Thickness = 2, Color = BOX_COLOR, Visible = false, ZIndex = 5}),
        boxBottom = newDrawing("Line", {Thickness = 2, Color = BOX_COLOR, Visible = false, ZIndex = 5}),
        boxLeft   = newDrawing("Line", {Thickness = 2, Color = BOX_COLOR, Visible = false, ZIndex = 5}),
        boxRight  = newDrawing("Line", {Thickness = 2, Color = BOX_COLOR, Visible = false, ZIndex = 5}),
        hpBg      = newDrawing("Line", {Thickness = 11, Color = HP_BG_COLOR, Visible = false, ZIndex = 4}),
        hpBar     = newDrawing("Line", {Thickness = 11, Color = HP_COLOR_HIGH, Visible = false, ZIndex = 5}),
        tracer    = newDrawing("Line", {Thickness = 1.5, Color = TRACER_COLOR, Visible = false, ZIndex = 3}),
    }

    espData[target.UserId] = drawings

    local conn = RunService.RenderStepped:Connect(function()
        if not _G.ESPEnabled then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end

        local char = target.Character
        if not char then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")

        if not hrp or not hum or not head then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end

        if hum.Health <= 0 then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end

        local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end

        local headPos = Camera:WorldToViewportPoint(head.Position)
        local feetPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

        local height = math.abs(headPos.Y - feetPos.Y)
        local width = height * 0.65
        local centerX = rootPos.X

        local left   = centerX - width / 2
        local right  = centerX + width / 2
        local top    = headPos.Y - 5
        local bottom = feetPos.Y + 3

        drawings.boxTop.From    = Vector2.new(left, top)
        drawings.boxTop.To      = Vector2.new(right, top)
        drawings.boxBottom.From = Vector2.new(left, bottom)
        drawings.boxBottom.To   = Vector2.new(right, bottom)
        drawings.boxLeft.From   = Vector2.new(left, top)
        drawings.boxLeft.To     = Vector2.new(left, bottom)
        drawings.boxRight.From  = Vector2.new(right, top)
        drawings.boxRight.To    = Vector2.new(right, bottom)

        drawings.boxTop.Visible    = true
        drawings.boxBottom.Visible = true
        drawings.boxLeft.Visible   = true
        drawings.boxRight.Visible  = true

        local hpX = left - 8
        local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local hpHeight = bottom - top
        local hpFilled = hpHeight * hpPct

        drawings.hpBg.From    = Vector2.new(hpX, top)
        drawings.hpBg.To      = Vector2.new(hpX, bottom)
        drawings.hpBg.Visible = true

        drawings.hpBar.From    = Vector2.new(hpX, bottom)
        drawings.hpBar.To      = Vector2.new(hpX, bottom - hpFilled)
        drawings.hpBar.Visible = true

        if hpPct > 0.6 then
            drawings.hpBar.Color = HP_COLOR_HIGH
        elseif hpPct > 0.3 then
            drawings.hpBar.Color = HP_COLOR_MID
        else
            drawings.hpBar.Color = HP_COLOR_LOW
        end

        local screenSize = Camera.ViewportSize
        drawings.tracer.From    = Vector2.new(screenSize.X / 2, screenSize.Y)
        drawings.tracer.To      = Vector2.new(centerX, bottom)
        drawings.tracer.Visible = true
    end)

    table.insert(espConnections, conn)

    target.CharacterRemoving:Connect(function()
        for _, d in pairs(drawings) do d.Visible = false end
    end)
end

local function updateESP()
    if _G.ESPEnabled then
        for _, v in pairs(Players:GetPlayers()) do
            if not espData[v.UserId] then
                createESP(v)
            end
        end
        Players.PlayerAdded:Connect(function(v)
            if _G.ESPEnabled then createESP(v) end
        end)
    else
        clearESP()
    end
end

