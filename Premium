-- Check VIP Status
local function isVIP()
    local username = player.Name
    local userid = tostring(player.UserId)
    
    for _, vipUser in pairs(VIPData.users or {}) do
        if vipUser.username == username or vipUser.userid == userid then
            local expiryTime = vipUser.expiry
            if expiryTime > os.time() then
                return true, math.floor((expiryTime - os.time()) / 86400) -- days remaining
            end
        end
    end
    return false, 0
end

local hasVIP, daysLeft = isVIP()

-- ESP System dengan Garis (bukan username)
local function createESP()
    if espFolder then
        espFolder:Destroy()
    end
    
    espFolder = Instance.new("Folder")
    espFolder.Name = "ESPFolder"
    espFolder.Parent = game.CoreGui
    
    local function addESP(plr)
        if plr == player then return end
        
        local function updateESP()
            pcall(function()
                local espGui = espFolder:FindFirstChild(plr.Name)
                if not espGui and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    espGui = Instance.new("BillboardGui")
                    espGui.Name = plr.Name
                    espGui.Adornee = plr.Character.HumanoidRootPart
                    espGui.Size = UDim2.new(4, 0, 5, 0)
                    espGui.AlwaysOnTop = true
                    espGui.Parent = espFolder
                    
                    -- Box Lines (Garis Kotak)
                    local function createLine(pos, size)
                        local line = Instance.new("Frame")
                        line.Position = pos
                        line.Size = size
                        line.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                        line.BorderSizePixel = 0
                        line.Parent = espGui
                        return line
                    end
                    
                    -- Top
                    createLine(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 2))
                    -- Bottom
                    createLine(UDim2.new(0, 0, 1, -2), UDim2.new(1, 0, 0, 2))
                    -- Left
                    createLine(UDim2.new(0, 0, 0, 0), UDim2.new(0, 2, 1, 0))
                    -- Right
                    createLine(UDim2.new(1, -2, 0, 0), UDim2.new(0, 2, 1, 0))
                    
                    -- Health Bar
                    local healthBar = Instance.new("Frame")
                    healthBar.Position = UDim2.new(0, -10, 0, 0)
                    healthBar.Size = UDim2.new(0, 4, 1, 0)
                    healthBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    healthBar.BorderSizePixel = 0
                    healthBar.Parent = espGui
                    
                    local healthFill = Instance.new("Frame")
                    healthFill.Position = UDim2.new(0, 0, 1, 0)
                    healthFill.Size = UDim2.new(1, 0, 0, 0)
                    healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    healthFill.BorderSizePixel = 0
                    healthFill.AnchorPoint = Vector2.new(0, 1)
                    healthFill.Parent = healthBar
                    
                    spawn(function()
                        while espGui and _G.ESPEnabled do
                            pcall(function()
                                if plr.Character and plr.Character:FindFirstChild("Humanoid") then
                                    local health = plr.Character.Humanoid.Health
                                    local maxHealth = plr.Character.Humanoid.MaxHealth
                                    local healthPercent = health / maxHealth
                                    
                                    healthFill.Size = UDim2.new(1, 0, healthPercent, 0)
                                    
                                    if healthPercent > 0.5 then
                                        healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                                    elseif healthPercent > 0.25 then
                                        healthFill.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                                    else
                                        healthFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                                    end
                                end
                            end)
                            wait(0.1)
                        end
                    end)
                end
                
                if espGui and (not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart")) then
                    espGui:Destroy()
                end
            end)
        end
        
        plr.CharacterAdded:Connect(updateESP)
        if plr.Character then
            updateESP()
        end
    end
    
    for _, plr in pairs(Players:GetPlayers()) do
        addESP(plr)
    end
    
    Players.PlayerAdded:Connect(addESP)
end

local function removeESP()
    if espFolder then
        espFolder:Destroy()
        espFolder = nil
    end
end

