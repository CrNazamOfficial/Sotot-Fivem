    lbl.Size=UDim2.new(1,-60,1,0) lbl.Position=UDim2.new(0,12,0,0)
    lbl.BackgroundTransparency=1 lbl.Text=label lbl.TextColor3=C.TEXT
    lbl.Font=Enum.Font.GothamSemibold lbl.TextSize=12 lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Parent=row

    local track=Instance.new("Frame")
    track.Size=UDim2.new(0,40,0,20) track.Position=UDim2.new(1,-52,0.5,-10)
    track.BackgroundColor3=C.OFF track.BorderSizePixel=0 track.Parent=row
    corner(track,10)

    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,14,0,14) knob.Position=UDim2.new(0,3,0.5,-7)
    knob.BackgroundColor3=Color3.fromRGB(255,255,255) knob.BorderSizePixel=0 knob.Parent=track
    corner(knob,7)

    local state=false
    local hitbox=Instance.new("TextButton")
    hitbox.Size=UDim2.new(1,0,1,0) hitbox.BackgroundTransparency=1 hitbox.Text="" hitbox.Parent=row

    hitbox.MouseButton1Click:Connect(function()
        state=not state
        TweenService:Create(track,TweenInfo.new(0.18),{BackgroundColor3=state and C.BLUE or C.OFF}):Play()
        TweenService:Create(knob,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{Position=state and UDim2.new(0,23,0.5,-7) or UDim2.new(0,3,0.5,-7)}):Play()
        if onToggle then onToggle(state) end
    end)

    return row
